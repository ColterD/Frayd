# Allowlist only the files the images build from; everything else stays out of the context.
*
!Dockerfile
!Dockerfile.proxy
!nginx.conf
!server/Cargo.toml
!server/Cargo.lock
!server/build.rs
!server/*.sql
!server/src/**
!server/tests/**
!client/index.html
!client/css/**
!client/js/**
!client/vendor/**

# Local state, secrets and editor leftovers inside allowlisted directories.
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/.DS_Store
**/*~
**/*.swp
**/*.orig
**/*.rej
