# Only application sources and proxy configuration belong in the build context.
*
!Dockerfile
!Dockerfile.proxy
!nginx.conf
!server/
!server/Cargo.toml
!server/Cargo.lock
!server/*.sql
!server/src/
!server/src/**
!server/tests/
!server/tests/**
!client/
!client/**
client/install/
server/target/

# Environment files must remain excluded after the client allowlist.
**/.env
**/.env.*
